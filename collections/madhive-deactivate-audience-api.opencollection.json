{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive deactivate audience API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "deactivate audience",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ability to archive an audience. The archived audience will not be removed from any line items, just removed from lists moving forward and will error if applied to new line items.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api2.madhive.com/api/v1/audiences/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "audience id"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Ability to archive an audience. The archived audience will not be removed from any line items, just removed from lists moving forward and will error if applied to new line items."
        }
      ]
    }
  ],
  "bundled": true
}