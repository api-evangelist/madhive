{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive retargeting segment retrieval API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "retargeting segment retrieval",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send a retargeting segment ID of any type (campaign, line item, tracking pixel or creative) and retrieve all retargeting segment information.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.madhive.com/api/v1/retargeting/:id",
            "headers": [
              {
                "name": "X-Cloud-Trace-Context",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "retargeting segment id"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Send a retargeting segment ID of any type (campaign, line item, tracking pixel or creative) and retrieve all retargeting segment information."
        }
      ]
    }
  ],
  "bundled": true
}