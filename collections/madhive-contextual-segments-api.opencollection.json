{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive contextual segments API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "contextual segments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List available contextual segments for targeting and avoidance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.madhive.com/api/v1/contextual-segments",
            "headers": [
              {
                "name": "X-Cloud-Trace-Context",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "type",
                "value": "TARGETING",
                "type": "query",
                "description": "Filter segments by type (TARGETING or AVOIDANCE). If omitted, returns all contextual segments."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns the list of contextual segments (IAS) available for use in line item contextual targeting and avoidance. Segments can be filtered by type (TARGETING or AVOIDANCE)."
        }
      ]
    }
  ],
  "bundled": true
}