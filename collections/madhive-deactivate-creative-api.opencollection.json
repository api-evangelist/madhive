{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive deactivate creative API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "deactivate creative",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ability to archive a creative. This removes the creatives from being added to line items moving forward and does not remove a creative from any associated line item.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api2.madhive.com/api/v1/creatives/:id",
            "headers": [
              {
                "name": "X-Cloud-Trace-Context",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "resource id"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Ability to archive a creative. This removes the creatives from being added to line items moving forward and does not remove a creative from any associated line item."
        }
      ]
    }
  ],
  "bundled": true
}