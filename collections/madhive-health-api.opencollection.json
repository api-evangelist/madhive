{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive Health API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "health of the service",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.madhive.com/api/health",
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "health check"
        }
      ]
    }
  ],
  "bundled": true
}