{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive update line item start/end dates API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "update line item start/end dates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "update line item schedule",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api2.madhive.com/api/v1/lineitems/:id/schedule",
            "headers": [
              {
                "name": "X-Cloud-Trace-Context",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "line item id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Editing line item start/end dates which will adjust campaign start/end dates to be inclusive of the line item date ranges. Unable to edit start dates that are in the past if it has been set live."
        }
      ]
    }
  ],
  "bundled": true
}