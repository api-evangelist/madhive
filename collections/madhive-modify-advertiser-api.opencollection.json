{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive modify advertiser API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "modify advertiser",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ability to update an advertiser including Advertiser Name, Advertiser Domain, IAB Category, Associated Agency, and External ID. Receives back the updated Advertiser.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api2.madhive.com/api/v1/advertisers/:id",
            "headers": [
              {
                "name": "X-Cloud-Trace-Context",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "resource id"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Ability to update an advertiser including Advertiser Name, Advertiser Domain, IAB Category, Associated Agency, and External ID. Receives back the updated Advertiser."
        }
      ]
    }
  ],
  "bundled": true
