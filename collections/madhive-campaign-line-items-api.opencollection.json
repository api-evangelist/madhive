{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive campaign line items API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "campaign line items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Receive all campaign or line item details when sending the IDs. Includes campaign/line item status details.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.madhive.com/api/v1/campaigns/:id/lineitems",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "campaign id"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Receive all campaign or line item details when sending the IDs. Includes campaign/line item status details."
        }
      ]
    }
  ],
  "bundled": true
}