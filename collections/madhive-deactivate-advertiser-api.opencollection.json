{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive deactivate advertiser API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "deactivate advertiser",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ability to archive an advertiser",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api2.madhive.com/api/v1/advertisers/:id",
            "headers": [
              {
                "name": "X-Cloud-Trace-Context",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "resource id"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Ability to archive an advertiser. This removes the advertiser from being added to campaigns moving forward and does not remove an advertiser from any associated campaigns"
        }
      ]
    }
  ],
  "bundled": true
}