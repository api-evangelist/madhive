{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive publisher group retrieval API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "publisher group retrieval",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send publisher group ID and retrieve list of providers in the publisher group",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.madhive.com/api/v1/publishergroups/:id",
            "headers": [
              {
                "name": "X-Cloud-Trace-Context",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "publisher group id"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Send publisher group ID and retrieve list of providers in the publisher group"
        }
      ]
    }
  ],
  "bundled": true
}