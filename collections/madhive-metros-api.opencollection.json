{
  "opencollection": "1.0.0",
  "info": {
    "name": "Madhive Metros API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "metros",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve all available metro codes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.madhive.com/api/v1/metros",
            "headers": [
              {
                "name": "X-Cloud-Trace-Context",
                "value": ""
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://api2.madhive.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a list of all available metro codes and their names"
        }
      ]
    }
  ],
  "bundled": true
}